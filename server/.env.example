# ---- Core ----
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trpb
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API with cookies (comma-separated).
CLIENT_URL=http://localhost:5173

# Cookie policy. Keep "lax" when the client and API share a site (same domain,
# or the Vite dev proxy). Use "none" (forces Secure) when they are on different sites.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# ---- Seed ----
# The seed script creates this administrator. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-1
# Optional: password for the seeded demo editors/users. Random if unset.
# SEED_USER_PASSWORD=

# ---- Cloudinary (optional) ----
# Leave blank in development: uploads are stored in server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# How often the in-process scheduler checks for due scheduled articles (ms).
# SCHEDULER_INTERVAL_MS=60000

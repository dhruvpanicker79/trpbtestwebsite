# Base URL for API requests from the browser.
# Development: leave as /api — Vite proxies it to the Express server.
# Production (separate API host): https://api.yourdomain.com/api
VITE_API_URL=/api

# Public site URL used for canonical links and Open Graph tags.
VITE_SITE_URL=http://localhost:5173

# Where the Vite dev proxy sends /api, /uploads, /sitemap.xml and /robots.txt.
VITE_DEV_API_TARGET=http://localhost:5000
